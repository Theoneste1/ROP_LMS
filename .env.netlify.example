# Netlify Environment Variables Template
# Copy these to your Netlify dashboard: Site settings → Environment variables

# Database Connection (PostgreSQL)
# Get this from Supabase, Neon, Railway, or your PostgreSQL provider
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# NextAuth.js Configuration
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here-minimum-32-characters

# Your Netlify site URL (update after first deployment)
# Format: https://your-site-name.netlify.app
NEXTAUTH_URL=https://your-site-name.netlify.app

# Optional: Resend API Key for contact form emails
# Get from https://resend.com
RESEND_API_KEY=re_your_api_key_here
